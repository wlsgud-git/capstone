generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model career {
  id           Int       @id @default(autoincrement())
  phone_num    String    @db.VarChar(11)
  role         String?   @db.VarChar(30)
  company_name String?   @db.VarChar(40)
  start_date   DateTime? @db.Timestamp(0)
  end_date     DateTime? @db.Timestamp(0)
  users        users     @relation(fields: [phone_num], references: [phone_num], onDelete: Cascade, onUpdate: NoAction, map: "career_ibfk_1")

  @@index([phone_num], map: "phone_num")
}

model chatroom {
  id        Int        @id @default(autoincrement())
  phone_num String     @db.VarChar(30)
  objective String     @db.VarChar(50)
  create_at DateTime   @default(now()) @db.Timestamp(0)
  users     users      @relation(fields: [phone_num], references: [phone_num], onDelete: Cascade, onUpdate: NoAction, map: "chatroom_ibfk_1")
  question  question[]

  @@index([phone_num], map: "phone_num")
}

model education {
  id          Int      @id @default(autoincrement())
  phone_num   String   @db.VarChar(11)
  school_name String?  @db.VarChar(15)
  major       String?  @db.VarChar(20)
  graduate    Boolean?
  users       users    @relation(fields: [phone_num], references: [phone_num], onDelete: Cascade, onUpdate: NoAction, map: "education_ibfk_1")

  @@index([phone_num], map: "phone_num")
}

model project {
  id           Int       @id @default(autoincrement())
  phone_num    String    @db.VarChar(11)
  project_name String?   @db.VarChar(50)
  role         String?   @db.VarChar(30)
  start_date   DateTime? @db.Timestamp(0)
  end_date     DateTime? @db.Timestamp(0)
  users        users     @relation(fields: [phone_num], references: [phone_num], onDelete: Cascade, onUpdate: NoAction, map: "project_ibfk_1")

  @@index([phone_num], map: "phone_num")
}

model question {
  id          Int      @id @default(autoincrement())
  chatroom_id Int
  phone_num   String   @db.VarChar(30)
  question    String   @db.Text
  create_at   DateTime @default(now()) @db.Timestamp(0)
  answer      String?  @db.Text
  feedback    Json?
  users       users    @relation(fields: [phone_num], references: [phone_num], onDelete: Cascade, onUpdate: NoAction, map: "question_ibfk_1")
  chatroom    chatroom @relation(fields: [chatroom_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "question_ibfk_2")

  @@index([phone_num], map: "phone_num")
  @@index([chatroom_id], map: "chatroom_id")
}

model skill {
  id        Int    @id @default(autoincrement())
  phone_num String @db.VarChar(11)
  skill     Json?
  users     users  @relation(fields: [phone_num], references: [phone_num], onDelete: Cascade, onUpdate: NoAction, map: "skill_ibfk_1")

  @@index([phone_num], map: "phone_num")
}

model users {
  phone_num String      @id @db.VarChar(11)
  name      String      @db.VarChar(20)
  career    career[]
  chatroom  chatroom[]
  education education[]
  project   project[]
  question  question[]
  skill     skill[]
}
